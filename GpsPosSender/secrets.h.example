// WiFi credentials + API secret — do NOT commit this file to git.
// Fill in your network's SSID/password and a strong random API secret below.

#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Shared secret between this device and vi-tri-server. Every /api/pos
// request is HMAC-SHA256-signed with this key (see hmacSha256Hex() in
// GpsPosSender.ino) so the server can tell a real device from someone who
// merely guessed ROOM_CODE. Must exactly match API_SECRET on the server
// (lam_viec/vi-tri-server/server.js, set via env var — see HUONG_DAN.txt).
// Generate a fresh long random value per deployment, e.g. in PowerShell:
//   -join ((1..48) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
#define API_SECRET "change-me-long-random-hex"

#endif
